# DocuRAG Configuration — copy to .env and adjust as needed

# --- Server ---
HOST=0.0.0.0
PORT=5000
DEBUG=false
LOG_LEVEL=INFO

# --- Paths (relative to repo root) ---
DOCS_DIR=docs
CACHE_DIR=.rag_cache
MODELS_DIR=models
STATIC_DIR=src/ui/static
TEMPLATES_DIR=src/ui/templates

# --- Retrieval Tuning ---
CHUNK_SIZE=650
CHUNK_OVERLAP=120
TOP_K_CANDIDATES=20
TOP_N_RERANK=5
RRF_K=60
DENSE_WEIGHT=0.6
BM25_WEIGHT=0.4
RERANK_FUSION_ALPHA=0.85
MMR_ENABLED=true
MMR_LAMBDA=0.5

# --- Faithfulness (Abstention + Corrective Retry) ---
ENABLE_ABSTENTION=true
ABSTAIN_MIN_SCORE=-10.0
ENABLE_CORRECTIVE_RETRY=true

# --- Ingestion (OCR via tesseract CLI) ---
ENABLE_OCR=true
OCR_DPI=300
OCR_MIN_CHARS=50

# --- Models ---
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
USE_RERANKER=true

# --- LLM Provider ---
# Options: auto | ollama | llamacpp
LLM_PROVIDER=auto
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
GGUF_MODEL_PATH=models/tinyllama-1.1b-chat-v1.0.Q5_K_M.gguf